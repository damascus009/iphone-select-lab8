{
  "framework": null,
  "buildCommand": "node scripts/build-public.cjs",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/assets/js/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "installCommand": "pnpm install --frozen-lockfile"
}
